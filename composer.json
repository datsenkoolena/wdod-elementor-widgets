{
	"name": "wdod/elementor-widgets",
	"description": "Three production-ready Elementor widgets (Pricing Table, Team Member, Testimonial Slider) with shortcode fallbacks.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"elementor",
		"widgets",
		"plugin"
	],
	"homepage": "https://github.com/datsenkoolena/wdod-elementor-widgets",
	"authors": [
		{
			"name": "Olena Datsenko",
			"email": "datsenkolena@gmail.com",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"scripts": {
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 -P4 php -l",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf"
	},
	"scripts-descriptions": {
		"lint": "Syntax-check every PHP file.",
		"phpcs": "Run WordPress Coding Standards + PHPCompatibility checks.",
		"phpcbf": "Auto-fix what phpcbf can fix."
	}
}
